HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PROFILE_STORAGE_DIR=profiles
# Admin endpoints stay disabled until a random key of at least 32 characters is set.
# Generate one locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ADMIN_API_KEY=
ENABLE_RETRAINING_SCHEDULER=false
# Bundled market information is mock data. Keep its influence off for the demo.
MARKET_WEIGHT=0
# Optional: install anthropic and set an API key to enable explanations.
# ANTHROPIC_API_KEY=
# Model IDs: https://platform.claude.com/docs/en/models/overview
ANTHROPIC_MODEL=claude-haiku-4-5
